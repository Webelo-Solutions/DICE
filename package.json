    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "docx": "^9.6.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.0",
    "exceljs": "^4.4.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.22.3",
