    "@fastify/websocket": "^11.2.0",
    "@google/generative-ai": "^0.24.1",
    "acme-client": "^5.4.0",
    "better-sqlite3": "^12.10.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "framer-motion": "^11.0.0",
    "openai": "^6.38.0",
    "pdfkit": "^0.18.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
