# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build output ──────────────────────────────────────────────────────────────
# NOTE: git does not support trailing inline comments — a '#' only starts a
# comment at the start of a line. Keep each comment on its own line above the
# pattern, or the pattern silently matches nothing.
# Vite SPA build
dist/
# build:release payload (bundled server, node.exe, deps, installer)
release/
# tsc -b incremental build info
*.tsbuildinfo
# generated from package.json by build:release
installer/version.iss

# ── DICE runtime data (NEVER commit) ──────────────────────────────────────────
# SQLite database + WAL/shared-memory sidecars. Holds rosters, sessions, history,
# rooms, and imported content packs — local data, not source.
data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ── Generated documents (regenerate with `npm run build:docs`) ────────────────
docs/*.docx
docs/*.pdf

# ── Secrets / local config ────────────────────────────────────────────────────
# (DICE keeps the LLM API key in the browser's localStorage, not in files — but
# guard against any stray env files just in case.)
.env
.env.*
!.env.example

# ── Editor / OS noise ─────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── Logs / misc ───────────────────────────────────────────────────────────────
*.log
npm-debug.log*
.cache/
